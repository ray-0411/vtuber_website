# PowerShell 使用方式：
# $env:LIVE_DATA_DB = "C:\path\to\live_data.db"
LIVE_DATA_DB=C:\path\to\live_data.db
ANALYTICS_CACHE_DB=C:\path\to\analytics_cache.db

# Server-side sync only. Never expose or commit the real connection string.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres
